# ─── Supabase ──────────────────────────────────────────────────────────────────
# Haal op via: supabase.com → jouw project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=           # Project URL (https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # anon / public key
SUPABASE_SERVICE_ROLE_KEY=          # service_role key (GEHEIM — alleen server-side)

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Haal op via: stripe.com/dashboard → Developers → API keys

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # pk_live_... of pk_test_...
STRIPE_SECRET_KEY=                  # sk_live_... of sk_test_... (GEHEIM)
STRIPE_WEBHOOK_SECRET=              # whsec_... (Stripe → Webhooks → endpoint → signing secret)
#                                   # Webhook URL: https://jouw-app.vercel.app/api/stripe/webhook
#                                   # Events: payment_intent.succeeded

# ─── Push Notificaties (VAPID) ─────────────────────────────────────────────────
# Genereer eenmalig met: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # BPN-... (publiek, veilig in client)
VAPID_PRIVATE_KEY=                  # Lange base64 string (GEHEIM)
VAPID_EMAIL=mailto:info@servr.app   # Contact e-mail voor push service

# ─── Anthropic (OS Agents) ─────────────────────────────────────────────────────
# Haal op via: platform.anthropic.com → API Keys

ANTHROPIC_API_KEY=                  # sk-ant-... (GEHEIM)

# ─── Optioneel ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_MAPBOX_TOKEN=           # Mapbox token (voor kaartweergave, optioneel)
NEXT_PUBLIC_APP_URL=http://localhost:3000  # App URL (voor push notificaties)
